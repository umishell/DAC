# Copy to .env and fill in local values. Never commit .env.

# Gateway
JWT_SECRET=change-me-to-a-long-random-string
GATEWAY_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:4200
PORT=3000

# Internal MS URLs (Docker network)
AUTH_URL=http://auth:8080
CLIENTE_URL=http://cliente:8080
GERENTE_URL=http://gerente:8080
CONTA_URL=http://conta:8080
SAGA_URL=http://saga:8080
EMAIL_URL=http://email:8080

# Email (SMTP Gmail). Leave empty in MAIL_DEV.
MAIL_DEV=true
MAIL_OUTBOX_DIR=/tmp/outbox
GMAIL_USER=
GMAIL_APP_PASSWORD=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bantads
POSTGRES_USER=bantads
POSTGRES_PASSWORD=change-me

POSTGRES_CLIENTE_USER=bantads_cliente
POSTGRES_CLIENTE_PASSWORD=change-me
POSTGRES_GERENTE_USER=bantads_gerente
POSTGRES_GERENTE_PASSWORD=change-me
POSTGRES_CONTA_COMMAND_USER=bantads_conta_command
POSTGRES_CONTA_COMMAND_PASSWORD=change-me
POSTGRES_CONTA_QUERY_USER=bantads_conta_query
POSTGRES_CONTA_QUERY_PASSWORD=change-me

# MongoDB (MS Auth)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=bantads_auth
MONGO_USER=bantads
MONGO_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
# load_definitions skips RABBITMQ_DEFAULT_USER; password_hash in
# db/rabbitmq/definitions.json is for this example password (change-me).
# If you change RABBIT_PASSWORD, regenerate the hash (rabbitmqctl hash_password)
# and update definitions.json, or the MSs cannot log in.
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=bantads
RABBIT_PASSWORD=change-me
RABBIT_MANAGEMENT_PORT=15672
